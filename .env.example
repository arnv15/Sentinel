# Sentinel secrets — copy this file to `.env` and fill in the values.
# `.env` is git-ignored. Never commit real tokens.
#
#     cp .env.example .env
#
# One .env covers both phases; leave a section blank if you only run one.

# ----- Phase 1: scraper (Discord -> Telegram) -----

# Discord USER token (this uses discord.py-self — see the ToS warning in the README).
DISCORD_TOKEN=

# The Discord channel to watch. Enable Developer Mode, right-click channel -> Copy ID.
TARGET_CHANNEL_ID=

# Telegram bot token from @BotFather.
TELEGRAM_BOT_TOKEN=

# Comma-separated Telegram chat IDs to alert (e.g. 111111,222222).
TELEGRAM_CHAT_IDS=

# ----- Phase 2: browser research agent -----

# Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
