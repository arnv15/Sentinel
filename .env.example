# Sentinel secrets — copy this file to `.env` and fill in the values.
# `.env` is git-ignored. Never commit real tokens.
#
#     cp .env.example .env
#
# One .env covers both phases; leave a section blank if you only run one.

# ----- Phase 1: scraper (Discord -> Telegram) -----

# ----- Where alerts are delivered (set either, or both) -----

# Discord webhook — no bot, no account, ~30 seconds to set up:
#   your server -> Settings -> Integrations -> Webhooks -> New Webhook -> Copy URL
# Looks like: https://discord.com/api/webhooks/123456789/AbCdEf...
DISCORD_WEBHOOK_URL=


# Discord USER token (this uses discord.py-self — see the ToS warning in the README).
DISCORD_TOKEN=

# The Discord channel to watch. Enable Developer Mode, right-click channel -> Copy ID.
TARGET_CHANNEL_ID=

# Telegram bot token from @BotFather.
TELEGRAM_BOT_TOKEN=

# Comma-separated Telegram chat IDs to alert (e.g. 111111,222222).
TELEGRAM_CHAT_IDS=

# ----- Phase 2: browser research agent -----

# Which LLM drives the loop. Everything except `anthropic` speaks the OpenAI
# Chat Completions format, so switching is a one-line change here.
#   gemini (default) | groq | cerebras | openrouter | github | ollama | anthropic
LLM_PROVIDER=gemini

# Optional — override the model for the chosen provider.
# gemini: gemini-3.7-flash (default) | gemini-3.5-flash | gemini-3.5-flash-lite
# LLM_MODEL=

# --- Set ONLY the key for the provider you picked ---

# Gemini (default). FREE tier, no credit card: https://aistudio.google.com/apikey
# NOTE: a Google AI Pro / Gemini Advanced subscription does NOT include API
# access — the API key is separate, and its free tier is available to any
# Google account. On the FREE tier Google uses submitted content to improve its
# products, so don't point a free-tier run at anything sensitive.
GEMINI_API_KEY=

# Other free options — see the table in browser_agent.py
# GROQ_API_KEY=
# CEREBRAS_API_KEY=
# OPENROUTER_API_KEY=
# GITHUB_TOKEN=

# Only needed if LLM_PROVIDER=anthropic — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Show the Chromium window (default) or run invisibly. Set to 1 for servers /
# unattended runs. NOTE: current @playwright/mcp is headed by default and only
# accepts --headless; the old --headed flag was removed.
HEADLESS=

# --- Watching the agent work ---

# Keep the Chromium window open when the run finishes, until you press Enter.
# Defaults ON for headed runs, OFF when HEADLESS=1. Without this the window
# closes the instant the loop ends, because tearing down the MCP subprocess
# takes the browser with it.
KEEP_OPEN=

# Seconds to pause after each tool call so you can follow along. Try 1 or 2.
STEP_DELAY=

# Write a Markdown transcript of each run to runs/ (git-ignored). Default on.
TRANSCRIPT=

# ----- Phase 1 -> Phase 2: fire the browser agent on a restock match -----

# Master switch. Off by default — with this unset the scraper behaves exactly
# as it always has and never imports the Phase 2 deps (openai / mcp).
AGENT_ENABLED=0

# Where the agent is pointed.
#   fixture (default) — the MockMart test storefront. The real product link from
#                       the alert is NOT put in the prompt.
#   live              — the actual retailer URL from the alert.
AGENT_TARGET_MODE=fixture
AGENT_FIXTURE_URL=https://arnv15.github.io/Sentinel/mock-store/

# One run at a time. Triggers arriving while a run is in flight, or inside the
# cooldown, are DROPPED (not queued) — a restock burst shouldn't build a backlog
# of tasks about items that already sold out.
AGENT_COOLDOWN_SECONDS=300
AGENT_TIMEOUT_SECONDS=600

# One step is roughly one API request. Gemini's free tier is ~1500/day, so the
# CLI default of 40 would cap you near 37 runs/day.
AGENT_MAX_STEPS=15
AGENT_MAX_RUNS_PER_DAY=20

# Show the Chromium window for bot-triggered runs (independent of HEADLESS,
# which controls the CLI). The bot always forces KEEP_OPEN off — it must never
# wait for someone to press Enter.
AGENT_HEADLESS=0

# Telegram a message when a run starts, quoting the prompt sent to the agent.
AGENT_ANNOUNCE=1

# Optional prompt override. Placeholders: {item} {price} {store} {stock}
# {limit} {link} {sku} {target}. In fixture mode {link} is always empty.
AGENT_TASK_TEMPLATE=

# ----- Context + reliability (browser agent) -----

# How many of the most recent tool results keep their full body; older ones are
# replaced with a short placeholder. `messages` is resent in full every step, so
# without this a 15-step run re-uploads fourteen stale accessibility trees.
# Measured at 8 steps: 48.5 KB -> 16.6 KB on the final request. 0 disables.
KEEP_SNAPSHOTS=2

# Retries for transient provider failures (429, 5xx, connection errors). The
# SDK default of 2 was not enough to ride out Gemini free-tier 503
# "this model is currently experiencing high demand" spikes.
LLM_MAX_RETRIES=5
