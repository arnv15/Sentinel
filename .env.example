# Sentinel (Discord -> Telegram) secrets. Copy to `.env` and fill in.
# `.env` is git-ignored — never commit real tokens.

# Discord USER token (this bot uses discord.py-self — see the ToS warning in the README).
DISCORD_TOKEN=

# The Discord channel to watch. Enable Developer Mode, right-click channel -> Copy ID.
TARGET_CHANNEL_ID=

# Telegram bot token from @BotFather.
TELEGRAM_BOT_TOKEN=

# Comma-separated Telegram chat IDs to alert (e.g. 111111,222222).
TELEGRAM_CHAT_IDS=
